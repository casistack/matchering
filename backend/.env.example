# Enhanced Matchering Backend Configuration
# Copy this file to .env and update values for your environment

# Application settings
MATCHERING_DEBUG=true
MATCHERING_HOST=127.0.0.1
MATCHERING_PORT=8000
MATCHERING_ENVIRONMENT=development

# Security settings
MATCHERING_SECRET_KEY=your-secret-key-here-at-least-32-characters-long
MATCHERING_ALLOWED_HOSTS=localhost,127.0.0.1
MATCHERING_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database settings
MATCHERING_DATABASE_URL=sqlite+aiosqlite:///./dev_matchering.db
MATCHERING_DATABASE_ECHO=true

# Redis settings for Celery
MATCHERING_REDIS_URL=redis://localhost:6379/0
MATCHERING_CELERY_BROKER_URL=redis://localhost:6379/0
MATCHERING_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File storage settings
MATCHERING_UPLOAD_DIR=./uploads
MATCHERING_RESULTS_DIR=./results
MATCHERING_MAX_FILE_SIZE=104857600
MATCHERING_ALLOWED_AUDIO_FORMATS=.wav,.mp3,.flac,.aiff

# Processing settings
MATCHERING_MAX_CONCURRENT_JOBS=5
MATCHERING_JOB_TIMEOUT_SECONDS=300

# Logging settings
MATCHERING_LOG_LEVEL=DEBUG